# Mem0 agentic-memory stack (plugins/harness6/infrastructure/mem0/docker-compose.yml).
# Separate from, and does not touch, the Graphiti services in ../docker-compose.yml.
# cp .env.example .env, fill in real values, never commit .env.
#
# Variable names deliberately match ../.env.example so values can be copied
# across; this file is read only by the mem0 compose project.

# --- LLM extraction + embeddings (OpenAI-compatible endpoints) ---
# OPENAI_API_URL must be the full /v1 base, e.g. https://api.openai.com/v1.
# Mem0 uses it as OPENAI_BASE_URL for both the extractor LLM and, unless
# EMBEDDER_API_URL is set, the embedder.
OPENAI_API_KEY=sk-...
OPENAI_API_URL=https://api.openai.com/v1

# Every add_memories call runs LLM fact extraction + an add/update/delete
# decision, so pick a cheap model that reliably emits structured JSON. Upstream
# images hardcode gpt-4o / gpt-4o-mini; these are applied by the build-time
# patches next to the compose file. Must exist on your OPENAI_API_URL server.
MEM_EXTRACTOR_MODEL=gpt-4o-mini

# Embedder endpoint, decoupled from the LLM endpoint as in ../.env.example.
# Leave EMBEDDER_API_URL unset to reuse OPENAI_API_URL.
EMBEDDER_API_URL=https://api.openai.com/v1
MEM_EMBED_MODEL=text-embedding-3-small
# Must match the model's output size. Fixed when the vector collections are first
# created — changing it later needs the volumes wiped. (Ollama nomic-embed-text: 768.)
EMBEDDER_DIMENSIONS=1536

# --- Postgres (pgvector) backing mem0-api ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# --- Neo4j graph store for mem0-api (min 8 chars) ---
NEO4J_PASSWORD=change-me

# --- OpenMemory MCP default user ---
# Created at startup. The user segment of the MCP URL is what scopes memories:
#   http://localhost:8765/mcp/claude-code/sse/<user>
# Keep it stable per person, not per repo.
MEM_USER_ID=default_user

# --- Host ports (loopback-only; defaults avoid ../docker-compose.yml's ports) ---
#MEM0_MCP_PORT=8765
#MEM0_API_PORT=8888
#MEM0_QDRANT_PORT=6333
#MEM0_POSTGRES_PORT=8432
#MEM0_NEO4J_BROWSER_PORT=8474
#MEM0_NEO4J_BOLT_PORT=8687

# Do NOT set OPENROUTER_API_KEY here: mem0's OpenAI client prefers it over
# OPENAI_BASE_URL and would silently bypass the endpoint above.
